# Bu dosyayi server/.env olarak kopyalayip doldurun. .env ASLA commit edilmez.

# LiteLLM model adi: saglayici/model
MODEL=gemini/gemini-3.5-flash-lite
# MODEL=openai/gpt-4o-mini
# MODEL=ollama/llama3.1

# Kullandiginiz saglayicinin anahtari
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# IP basina istek siniri (slowapi formati)
HIZ_SINIRI=20/minute

# Modelin dusunme seviyesi: disable (en hizli) | low | medium | high
DUSUNME=disable

# Meta-prompt surumu: v0 (ilk) | v1 (gercek testten sonra iyilestirilmis)
META_PROMPT_SURUMU=v1
